import {
  getAllPlaylistTracks,
  getCurrentPlaylist,
} from "../services/playlist";
import {
  classifyTracks,
  type ClassifiedTrack,
} from "../services/genres";

type MatchMode = "any" | "all";

function createElement<K extends keyof HTMLElementTagNameMap>(
  tag: K,
  text?: string
): HTMLElementTagNameMap[K] {
  const element = document.createElement(tag);

  if (text !== undefined) {
    element.textContent = text;
  }

  return element;
}

function createInfoRow(
  label: string,
  value: string
): HTMLDivElement {
  const row = createElement("div");

  row.style.padding = "14px 0";
  row.style.borderBottom =
    "1px solid rgba(255, 255, 255, 0.1)";

  const labelElement = createElement(
    "div",
    label
  );

  labelElement.style.color =
    "var(--spice-subtext, #b3b3b3)";
  labelElement.style.fontSize = "12px";
  labelElement.style.fontWeight = "700";
  labelElement.style.letterSpacing = "0.08em";
  labelElement.style.marginBottom = "6px";
  labelElement.style.textTransform = "uppercase";

  const valueElement = createElement(
    "div",
    value
  );

  valueElement.style.color =
    "var(--spice-text, #ffffff)";
  valueElement.style.fontSize = "18px";
  valueElement.style.fontWeight = "700";

  row.append(
    labelElement,
    valueElement
  );

  return row;
}

function createButton(
  label: string
): HTMLButtonElement {
  const button = createElement(
    "button",
    label
  );

  button.type = "button";
  button.style.width = "100%";
  button.style.marginTop = "22px";
  button.style.padding = "15px 20px";
  button.style.border = "0";
  button.style.borderRadius = "999px";
  button.style.background =
    "var(--spice-button, #1ed760)";
  button.style.color = "#000000";
  button.style.fontFamily = "inherit";
  button.style.fontSize = "15px";
  button.style.fontWeight = "700";
  button.style.cursor = "pointer";

  return button;
}

function createProgressBar(): {
  wrapper: HTMLDivElement;
  fill: HTMLDivElement;
} {
  const wrapper = createElement("div");
  const fill = createElement("div");

  wrapper.style.width = "100%";
  wrapper.style.height = "12px";
  wrapper.style.marginTop = "18px";
  wrapper.style.borderRadius = "999px";
  wrapper.style.overflow = "hidden";
  wrapper.style.background =
    "rgba(255, 255, 255, 0.12)";

  fill.style.width = "0%";
  fill.style.height = "100%";
  fill.style.borderRadius = "999px";
  fill.style.background =
    "var(--spice-button, #1ed760)";
  fill.style.transition =
    "width 120ms ease-out";

  wrapper.append(fill);

  return {
    wrapper,
    fill,
  };
}

function getTrackGenres(
  item: ClassifiedTrack
): string[] {
  return [
    item.primaryGenre,
    ...item.secondaryGenres,
  ].filter(
    (genre): genre is string =>
      Boolean(genre)
  );
}

function getAllGenres(
  classifications: ClassifiedTrack[]
): string[] {
  const genres = new Set<string>();

  for (const item of classifications) {
    for (const genre of getTrackGenres(item)) {
      genres.add(genre);
    }
  }

  return [...genres].sort(
    (a, b) => a.localeCompare(b)
  );
}

function createGenrePill(
  genre: string,
  primary: boolean
): HTMLSpanElement {
  const pill = createElement(
    "span",
    genre
  );

  pill.style.display = "inline-flex";
  pill.style.alignItems = "center";
  pill.style.padding = "4px 9px";
  pill.style.borderRadius = "999px";
  pill.style.fontSize = "11px";
  pill.style.fontWeight = "700";
  pill.style.whiteSpace = "nowrap";

  if (primary) {
    pill.style.background =
      "var(--spice-button, #1ed760)";
    pill.style.color = "#000000";
  } else {
    pill.style.background =
      "rgba(255, 255, 255, 0.1)";
    pill.style.color =
      "var(--spice-text, #ffffff)";
  }

  return pill;
}

function getNowPlayingUri(): string | null {
  return Spicetify.Player.data?.item?.uri ?? null;
}

function updateSongRowState(
  row: HTMLDivElement,
  title: HTMLDivElement,
  trackName: string,
  isPlaying: boolean,
  isQueued: boolean
): void {
  row.dataset.playing =
    isPlaying ? "true" : "false";

  row.dataset.queued =
    isQueued ? "true" : "false";

  title.textContent = trackName;

  if (isPlaying) {
    row.style.background =
      "rgba(30, 215, 96, 0.14)";
    row.style.boxShadow =
      "inset 3px 0 0 var(--spice-button, #1ed760)";
    title.style.color =
      "var(--spice-button, #1ed760)";

    return;
  }

  if (isQueued) {
    row.style.background =
      "rgba(74, 144, 226, 0.16)";
    row.style.boxShadow =
      "inset 3px 0 0 #4a90e2";
    title.style.color =
      "#69a9f5";

    return;
  }

  row.style.background =
    "transparent";
  row.style.boxShadow = "none";
  title.style.color =
    "var(--spice-text, #ffffff)";
}

function createSongRow(
  item: ClassifiedTrack
): HTMLDivElement {
  const row = createElement("div");

  row.style.display = "grid";
  row.style.gridTemplateColumns =
    "minmax(0, 1fr) auto";
  row.style.alignItems = "center";
  row.style.gap = "18px";
  row.style.padding = "14px 4px";
  row.style.borderBottom =
    "1px solid rgba(255, 255, 255, 0.08)";
  row.style.borderRadius = "8px";
  row.style.cursor = "pointer";
  row.style.transition =
    "background 120ms ease, transform 120ms ease";

  const information = createElement("div");

  information.style.minWidth = "0";

  const title = createElement(
    "div",
    item.track.name
  );

  title.style.fontSize = "15px";
  title.style.fontWeight = "700";
  title.style.color =
    "var(--spice-text, #ffffff)";
  title.style.whiteSpace = "nowrap";
  title.style.overflow = "hidden";
  title.style.textOverflow = "ellipsis";

  const artistNames = item.track.artists
    .map(artist => artist.name)
    .join(", ");

  const subtitleParts = [
    artistNames,
    item.track.album,
  ].filter(Boolean);

  const subtitle = createElement(
    "div",
    subtitleParts.join(" | ")
  );

  subtitle.style.marginTop = "4px";
  subtitle.style.color =
    "var(--spice-subtext, #b3b3b3)";
  subtitle.style.fontSize = "12px";
  subtitle.style.whiteSpace = "nowrap";
  subtitle.style.overflow = "hidden";
  subtitle.style.textOverflow = "ellipsis";

  information.append(
    title,
    subtitle
  );

  const pills = createElement("div");

  pills.style.display = "flex";
  pills.style.flexWrap = "wrap";
  pills.style.justifyContent = "flex-end";
  pills.style.gap = "6px";
  pills.style.maxWidth = "360px";

  if (item.primaryGenre) {
    pills.append(
      createGenrePill(
        item.primaryGenre,
        true
      )
    );
  }

  for (const genre of item.secondaryGenres) {
    pills.append(
      createGenrePill(
        genre,
        false
      )
    );
  }

  if (!item.primaryGenre) {
    const unknown = createGenrePill(
      "Unclassified",
      false
    );

    unknown.style.opacity = "0.65";
    pills.append(unknown);
  }

  row.append(
    information,
    pills
  );

  row.dataset.trackUri =
    item.track.uri ?? "";
  row.dataset.trackName =
    item.track.name;
  title.dataset.songTitle =
    "true";

  updateSongRowState(
    row,
    title,
    item.track.name,
    getNowPlayingUri() === item.track.uri,
    false
  );

  row.addEventListener(
    "mouseenter",
    () => {
      if (
        row.dataset.playing !== "true" &&
        row.dataset.queued !== "true"
      ) {
        row.style.background =
          "rgba(255, 255, 255, 0.07)";
      }

      row.style.transform =
        "translateX(3px)";
    }
  );

  row.addEventListener(
    "mouseleave",
    () => {
      const isPlaying =
        row.dataset.playing === "true";

      const isQueued =
        row.dataset.queued === "true";

      updateSongRowState(
        row,
        title,
        item.track.name,
        isPlaying,
        isQueued
      );

      row.style.transform =
        "translateX(0)";
    }
  );

  row.addEventListener(
    "click",
    async () => {
      const uri = item.track.uri;

      if (!uri) {
        Spicetify.showNotification(
          "This song does not have a playable Spotify URI.",
          true
        );

        return;
      }

      try {
        await Spicetify.Player.playUri(uri);
      } catch (error) {
        console.error(
          "[Playlist+] Could not play track:",
          error
        );

        Spicetify.showNotification(
          `Could not play ${item.track.name}.`,
          true
        );
      }
    }
  );

  return row;
}

function createModeButton(
  label: string
): HTMLButtonElement {
  const button = createElement(
    "button",
    label
  );

  button.type = "button";
  button.style.minWidth = "70px";
  button.style.padding = "8px 15px";
  button.style.border = "0";
  button.style.borderRadius = "999px";
  button.style.fontFamily = "inherit";
  button.style.fontSize = "12px";
  button.style.fontWeight = "700";
  button.style.cursor = "pointer";
  button.style.transition =
    "background 120ms ease, color 120ms ease";

  return button;
}

const playlistPlusQueuedTrackUris =
  new Set<string>();

function renderGenreLens(
  container: HTMLDivElement,
  classifications: ClassifiedTrack[]
): void {
  container.innerHTML = "";

  const queuedTrackUris =
    playlistPlusQueuedTrackUris;

  function refreshNowPlayingHighlight(): void {
    const playingUri =
      getNowPlayingUri();

    const rows =
      container.querySelectorAll<HTMLDivElement>(
        "[data-track-uri]"
      );

    for (const row of rows) {
      const title =
        row.querySelector<HTMLDivElement>(
          "[data-song-title]"
        );

      const trackName =
        row.dataset.trackName;

      if (!title || !trackName) {
        continue;
      }

      const trackUri =
        row.dataset.trackUri ?? "";

      const isPlaying =
        trackUri === playingUri;

      if (isPlaying) {
        queuedTrackUris.delete(trackUri);
      }

      updateSongRowState(
        row,
        title,
        trackName,
        isPlaying,
        queuedTrackUris.has(trackUri)
      );
    }
  }

  const handleSongChange = (): void => {
    refreshNowPlayingHighlight();
  };

  Spicetify.Player.addEventListener(
    "songchange",
    handleSongChange
  );

  const cleanupWatcher =
    window.setInterval(() => {
      if (container.isConnected) {
        return;
      }

      Spicetify.Player.removeEventListener(
        "songchange",
        handleSongChange
      );

      window.clearInterval(
        cleanupWatcher
      );
    }, 1000);

  const selectedGenres = new Set<string>();
  const genreControls = new Map<
    string,
    {
      button: HTMLButtonElement;
      count: HTMLSpanElement;
    }
  >();

  let matchMode: MatchMode = "any";
  let visibleLimit = 100;

  const classifiedCount =
    classifications.filter(
      item => item.primaryGenre
    ).length;

  const unclassifiedCount =
    classifications.length -
    classifiedCount;

  const allGenres =
    getAllGenres(classifications);

  const headingRow = createElement("div");

  headingRow.style.display = "flex";
  headingRow.style.alignItems = "flex-end";
  headingRow.style.justifyContent =
    "space-between";
  headingRow.style.gap = "16px";

  const headingGroup = createElement("div");

  const heading = createElement(
    "h2",
    "Genre Lens"
  );

  heading.style.margin = "0";
  heading.style.fontSize = "26px";

  const description = createElement(
    "div",
    "Select multiple genres to explore this playlist."
  );

  description.style.marginTop = "6px";
  description.style.color =
    "var(--spice-subtext, #b3b3b3)";
  description.style.fontSize = "13px";

  headingGroup.append(
    heading,
    description
  );

  const stats = createElement(
    "div",
    `${classifiedCount.toLocaleString()} classified | ${unclassifiedCount.toLocaleString()} unclassified`
  );

  stats.style.color =
    "var(--spice-subtext, #b3b3b3)";
  stats.style.fontSize = "12px";
  stats.style.fontWeight = "700";

  headingRow.append(
    headingGroup,
    stats
  );

  const controls = createElement("div");

  controls.style.display = "flex";
  controls.style.alignItems = "center";
  controls.style.justifyContent =
    "space-between";
  controls.style.flexWrap = "wrap";
  controls.style.gap = "12px";
  controls.style.marginTop = "24px";

  const selectedLabel = createElement(
    "div",
    "Showing all genres"
  );

  selectedLabel.style.fontSize = "13px";
  selectedLabel.style.fontWeight = "700";

  const rightControls = createElement("div");

  rightControls.style.display = "flex";
  rightControls.style.alignItems = "center";
  rightControls.style.gap = "10px";

  const modeGroup = createElement("div");

  modeGroup.style.display = "flex";
  modeGroup.style.padding = "3px";
  modeGroup.style.borderRadius = "999px";
  modeGroup.style.background =
    "rgba(255,255,255,0.08)";

  const anyButton =
    createModeButton("Any");

  const allButton =
    createModeButton("All");

  modeGroup.append(
    anyButton,
    allButton
  );

  const clearButton = createElement(
    "button",
    "Clear filters"
  );

  clearButton.type = "button";
  clearButton.style.padding = "8px 13px";
  clearButton.style.border =
    "1px solid rgba(255,255,255,0.2)";
  clearButton.style.borderRadius = "999px";
  clearButton.style.background =
    "transparent";
  clearButton.style.color =
    "var(--spice-text, #ffffff)";
  clearButton.style.fontFamily = "inherit";
  clearButton.style.fontSize = "12px";
  clearButton.style.fontWeight = "700";
  clearButton.style.cursor = "pointer";
  clearButton.style.visibility = "hidden";

  rightControls.append(
    modeGroup,
    clearButton
  );

  controls.append(
    selectedLabel,
    rightControls
  );

  const modeExplanation = createElement(
    "div",
    "Any shows songs containing at least one selected genre."
  );

  modeExplanation.style.marginTop = "8px";
  modeExplanation.style.color =
    "var(--spice-subtext, #b3b3b3)";
  modeExplanation.style.fontSize = "11px";

  const genresGrid = createElement("div");

  genresGrid.style.display = "grid";
  genresGrid.style.gridTemplateColumns =
    "repeat(4, minmax(0, 1fr))";
  genresGrid.style.gap = "10px";
  genresGrid.style.marginTop = "14px";

  const songsHeader = createElement("div");

  songsHeader.style.display = "flex";
  songsHeader.style.alignItems = "center";
  songsHeader.style.justifyContent =
    "space-between";
  songsHeader.style.gap = "12px";
  songsHeader.style.marginTop = "30px";
  songsHeader.style.paddingBottom = "12px";
  songsHeader.style.borderBottom =
    "1px solid rgba(255,255,255,0.12)";

  const songsHeading = createElement(
    "h3",
    "Songs"
  );

  songsHeading.style.margin = "0";
  songsHeading.style.fontSize = "20px";

  const songsHeaderControls =
    createElement("div");

  songsHeaderControls.style.display =
    "flex";
  songsHeaderControls.style.alignItems =
    "center";
  songsHeaderControls.style.gap =
    "12px";

  const matchCount = createElement(
    "div",
    ""
  );

  matchCount.style.color =
    "var(--spice-subtext, #b3b3b3)";
  matchCount.style.fontSize = "13px";
  matchCount.style.fontWeight = "700";

  const queueAllButton = createElement(
    "button",
    "Queue all"
  );

  queueAllButton.type = "button";
  queueAllButton.style.padding =
    "8px 15px";
  queueAllButton.style.border =
    "1px solid rgba(74, 144, 226, 0.7)";
  queueAllButton.style.borderRadius =
    "999px";
  queueAllButton.style.background =
    "rgba(74, 144, 226, 0.14)";
  queueAllButton.style.color =
    "#69a9f5";
  queueAllButton.style.fontFamily =
    "inherit";
  queueAllButton.style.fontSize =
    "12px";
  queueAllButton.style.fontWeight =
    "700";
  queueAllButton.style.cursor =
    "pointer";
  queueAllButton.style.transition =
    "background 120ms ease, opacity 120ms ease";

  queueAllButton.addEventListener(
    "mouseenter",
    () => {
      if (!queueAllButton.disabled) {
        queueAllButton.style.background =
          "rgba(74, 144, 226, 0.25)";
      }
    }
  );

  queueAllButton.addEventListener(
    "mouseleave",
    () => {
      if (!queueAllButton.disabled) {
        queueAllButton.style.background =
          "rgba(74, 144, 226, 0.14)";
      }
    }
  );

  const shuffleQueueButton =
    queueAllButton.cloneNode(
      true
    ) as HTMLButtonElement;

  shuffleQueueButton.textContent =
    "Shuffle queue";

  shuffleQueueButton.addEventListener(
    "mouseenter",
    () => {
      if (!shuffleQueueButton.disabled) {
        shuffleQueueButton.style.background =
          "rgba(74, 144, 226, 0.25)";
      }
    }
  );

  shuffleQueueButton.addEventListener(
    "mouseleave",
    () => {
      if (!shuffleQueueButton.disabled) {
        shuffleQueueButton.style.background =
          "rgba(74, 144, 226, 0.14)";
      }
    }
  );

  songsHeaderControls.append(
    matchCount,
    queueAllButton,
    shuffleQueueButton
  );

  songsHeader.append(
    songsHeading,
    songsHeaderControls
  );

  const songsList = createElement("div");

  const loadMoreButton = createElement(
    "button",
    "Load more songs"
  );

  loadMoreButton.type = "button";
  loadMoreButton.style.display = "none";
  loadMoreButton.style.width = "100%";
  loadMoreButton.style.marginTop = "18px";
  loadMoreButton.style.padding = "12px";
  loadMoreButton.style.border =
    "1px solid rgba(255,255,255,0.18)";
  loadMoreButton.style.borderRadius = "999px";
  loadMoreButton.style.background =
    "rgba(255,255,255,0.06)";
  loadMoreButton.style.color =
    "var(--spice-text, #ffffff)";
  loadMoreButton.style.fontFamily = "inherit";
  loadMoreButton.style.fontSize = "13px";
  loadMoreButton.style.fontWeight = "700";
  loadMoreButton.style.cursor = "pointer";

  const emptyState = createElement(
    "div",
    "No songs match the selected genres."
  );

  emptyState.style.display = "none";
  emptyState.style.padding = "40px 20px";
  emptyState.style.color =
    "var(--spice-subtext, #b3b3b3)";
  emptyState.style.textAlign = "center";

  function trackMatchesSelection(
    item: ClassifiedTrack
  ): boolean {
    if (selectedGenres.size === 0) {
      return true;
    }

    const trackGenres = getTrackGenres(item);

    if (matchMode === "all") {
      return [...selectedGenres].every(
        genre =>
          trackGenres.includes(genre)
      );
    }

    return [...selectedGenres].some(
      genre =>
        trackGenres.includes(genre)
    );
  }

  function getFilteredTracks():
    ClassifiedTrack[] {
    return classifications.filter(
      trackMatchesSelection
    );
  }

  function buildDynamicGenreCounts(
    currentMatches: ClassifiedTrack[]
  ): Map<string, number> {
    const counts = new Map<string, number>();

    for (const genre of allGenres) {
      counts.set(genre, 0);
    }

    for (const item of currentMatches) {
      const uniqueGenres = new Set(
        getTrackGenres(item)
      );

      for (const genre of uniqueGenres) {
        counts.set(
          genre,
          (counts.get(genre) ?? 0) + 1
        );
      }
    }

    return counts;
  }

  function updateModeButtons(): void {
    const anySelected =
      matchMode === "any";

    anyButton.style.background =
      anySelected
        ? "var(--spice-button, #1ed760)"
        : "transparent";

    anyButton.style.color =
      anySelected
        ? "#000000"
        : "var(--spice-text, #ffffff)";

    allButton.style.background =
      anySelected
        ? "transparent"
        : "var(--spice-button, #1ed760)";

    allButton.style.color =
      anySelected
        ? "var(--spice-text, #ffffff)"
        : "#000000";

    modeExplanation.textContent =
      matchMode === "any"
        ? "Any shows songs containing at least one selected genre."
        : "All shows songs containing every selected genre.";
  }

  function updateSelectionLabel(): void {
    if (selectedGenres.size === 0) {
      selectedLabel.textContent =
        "Showing all genres";

      clearButton.style.visibility =
        "hidden";

      return;
    }

    selectedLabel.textContent =
      `${selectedGenres.size} genre${selectedGenres.size === 1 ? "" : "s"} selected | Match ${matchMode}`;

    clearButton.style.visibility =
      "visible";
  }

  function updateGenreCards(
    currentMatches: ClassifiedTrack[]
  ): void {
    const dynamicCounts =
      buildDynamicGenreCounts(
        currentMatches
      );

    for (
      const [genre, control]
      of genreControls
    ) {
      const selected =
        selectedGenres.has(genre);

      const count =
        dynamicCounts.get(genre) ?? 0;

      control.count.textContent =
        count.toLocaleString();

      control.button.style.background =
        selected
          ? "var(--spice-button, #1ed760)"
          : "rgba(255,255,255,0.08)";

      control.button.style.color =
        selected
          ? "#000000"
          : "var(--spice-text, #ffffff)";

      control.button.style.borderColor =
        selected
          ? "var(--spice-button, #1ed760)"
          : "rgba(255,255,255,0.08)";

      control.button.style.opacity =
        count === 0 && !selected
          ? "0.45"
          : "1";
    }
  }

  function renderSongs(
    filteredTracks: ClassifiedTrack[]
  ): void {
    songsList.innerHTML = "";

    const tracksToRender =
      filteredTracks.slice(
        0,
        visibleLimit
      );

    for (const item of tracksToRender) {
      const row =
        createSongRow(item);

      const title =
        row.querySelector<HTMLDivElement>(
          "[data-song-title]"
        );

      if (title) {
        const trackUri =
          item.track.uri ?? "";

        updateSongRowState(
          row,
          title,
          item.track.name,
          trackUri === getNowPlayingUri(),
          queuedTrackUris.has(trackUri)
        );
      }

      songsList.append(row);
    }

    matchCount.textContent =
      `${filteredTracks.length.toLocaleString()} matching songs`;

    emptyState.style.display =
      filteredTracks.length === 0
        ? "block"
        : "none";

    const remaining =
      filteredTracks.length -
      tracksToRender.length;

    if (remaining > 0) {
      loadMoreButton.style.display =
        "block";

      loadMoreButton.textContent =
        `Load more songs (${remaining.toLocaleString()} remaining)`;
    } else {
      loadMoreButton.style.display =
        "none";
    }
  }

  function refresh(): void {
    const filteredTracks =
      getFilteredTracks();

    updateModeButtons();
    updateSelectionLabel();
    updateGenreCards(
      filteredTracks
    );
    renderSongs(
      filteredTracks
    );
  }

  for (const genre of allGenres) {
    const button = createElement(
      "button"
    );

    button.type = "button";
    button.style.display = "flex";
    button.style.alignItems = "center";
    button.style.justifyContent =
      "space-between";
    button.style.gap = "10px";
    button.style.padding = "13px 14px";
    button.style.border =
      "1px solid rgba(255,255,255,0.08)";
    button.style.borderRadius = "10px";
    button.style.background =
      "rgba(255,255,255,0.08)";
    button.style.color =
      "var(--spice-text, #ffffff)";
    button.style.fontFamily = "inherit";
    button.style.fontSize = "13px";
    button.style.fontWeight = "700";
    button.style.cursor = "pointer";
    button.style.transition =
      "background 120ms ease, color 120ms ease, opacity 120ms ease";

    const genreName = createElement(
      "span",
      genre
    );

    genreName.style.overflow = "hidden";
    genreName.style.textOverflow =
      "ellipsis";
    genreName.style.whiteSpace = "nowrap";

    const count = createElement(
      "span",
      "0"
    );

    count.style.opacity = "0.7";

    button.append(
      genreName,
      count
    );

    button.addEventListener(
      "click",
      () => {
        if (selectedGenres.has(genre)) {
          selectedGenres.delete(genre);
        } else {
          selectedGenres.add(genre);
        }

        visibleLimit = 100;
        refresh();
      }
    );

    genreControls.set(
      genre,
      {
        button,
        count,
      }
    );

    genresGrid.append(button);
  }

  anyButton.addEventListener(
    "click",
    () => {
      matchMode = "any";
      visibleLimit = 100;
      refresh();
    }
  );

  allButton.addEventListener(
    "click",
    () => {
      matchMode = "all";
      visibleLimit = 100;
      refresh();
    }
  );

  clearButton.addEventListener(
    "click",
    () => {
      selectedGenres.clear();
      visibleLimit = 100;
      refresh();
    }
  );

  loadMoreButton.addEventListener(
    "click",
    () => {
      visibleLimit += 100;

      renderSongs(
        getFilteredTracks()
      );

      refreshNowPlayingHighlight();
    }
  );

  async function queueFilteredTracks(
    button: HTMLButtonElement,
    shouldShuffle: boolean
  ): Promise<void> {
    const filteredTracks =
      getFilteredTracks();

    const playingUri =
      getNowPlayingUri();

    const playingIndex =
      filteredTracks.findIndex(
        item =>
          item.track.uri === playingUri
      );

    const tracksToQueue =
      playingIndex >= 0
        ? filteredTracks.slice(
            playingIndex + 1
          )
        : filteredTracks.filter(
            item =>
              item.track.uri !== playingUri
          );

    const uniqueUris = [
      ...new Set(
        tracksToQueue
          .map(item => item.track.uri)
          .filter(
            (uri): uri is string =>
              Boolean(uri)
          )
      ),
    ];

    if (shouldShuffle) {
      for (
        let index = uniqueUris.length - 1;
        index > 0;
        index -= 1
      ) {
        const randomIndex =
          Math.floor(
            Math.random() * (index + 1)
          );

        [
          uniqueUris[index],
          uniqueUris[randomIndex],
        ] = [
          uniqueUris[randomIndex],
          uniqueUris[index],
        ];
      }
    }

    if (uniqueUris.length === 0) {
      Spicetify.showNotification(
        "There are no matching songs left to queue."
      );

      return;
    }

    queueAllButton.disabled = true;
    shuffleQueueButton.disabled = true;

    queueAllButton.style.cursor =
      "default";

    shuffleQueueButton.style.cursor =
      "default";

    queueAllButton.style.opacity =
      "0.65";

    shuffleQueueButton.style.opacity =
      "0.65";

    button.textContent =
      shouldShuffle
        ? "Shuffling..."
        : "Queueing...";

    try {
      const batchSize = 100;

      for (
        let index = 0;
        index < uniqueUris.length;
        index += batchSize
      ) {
        const batch =
          uniqueUris
            .slice(
              index,
              index + batchSize
            )
            .map(uri => ({ uri }));

        await Spicetify.addToQueue(
          batch
        );
      }

      queuedTrackUris.clear();

      for (const uri of uniqueUris) {
        queuedTrackUris.add(uri);
      }

      refreshNowPlayingHighlight();

      Spicetify.showNotification(
        shouldShuffle
          ? `${uniqueUris.length.toLocaleString()} shuffled songs added to queue.`
          : `${uniqueUris.length.toLocaleString()} songs added to queue.`
      );
    } catch (error) {
      console.error(
        "[Playlist+] Could not queue filtered songs:",
        error
      );

      Spicetify.showNotification(
        "Could not add the matching songs to the queue.",
        true
      );
    } finally {
      queueAllButton.disabled = false;
      shuffleQueueButton.disabled = false;

      queueAllButton.style.cursor =
        "pointer";

      shuffleQueueButton.style.cursor =
        "pointer";

      queueAllButton.style.opacity =
        "1";

      shuffleQueueButton.style.opacity =
        "1";

      queueAllButton.textContent =
        "Queue all";

      shuffleQueueButton.textContent =
        "Shuffle queue";
    }
  }

  queueAllButton.addEventListener(
    "click",
    () => {
      void queueFilteredTracks(
        queueAllButton,
        false
      );
    }
  );

  shuffleQueueButton.addEventListener(
    "click",
    () => {
      void queueFilteredTracks(
        shuffleQueueButton,
        true
      );
    }
  );

  container.append(
    headingRow,
    controls,
    modeExplanation,
    genresGrid,
    songsHeader,
    songsList,
    emptyState,
    loadMoreButton
  );

  refresh();
}

function createPlaylistModalContent():
  HTMLDivElement {
  const container = createElement("div");
  const playlist = getCurrentPlaylist();

  container.style.display = "flex";
  container.style.flexDirection = "column";
  container.style.width = "100%";
  container.style.minWidth = "0";
  container.style.maxWidth = "100%";
  container.style.padding = "0 4px 24px";
  container.style.overflowX = "hidden";

  if (!playlist) {
    container.append(
      createInfoRow(
        "Current page",
        "Open a playlist to use Playlist+."
      )
    );

    return container;
  }

  container.append(
    createInfoRow(
      "Current playlist",
      playlist.name
    ),
    createInfoRow(
      "Songs",
      playlist.trackCount?.toLocaleString() ??
        "Unavailable"
    ),
    createInfoRow(
      "Owner",
      playlist.owner
    )
  );

  const button = createButton(
    "Open Genre Lens"
  );

  const progressSection =
    createElement("div");

  progressSection.style.display = "none";
  progressSection.style.marginTop = "22px";
  progressSection.style.padding = "20px";
  progressSection.style.borderRadius = "12px";
  progressSection.style.background =
    "rgba(255, 255, 255, 0.06)";

  const statusHeading = createElement(
    "div",
    "Preparing playlist..."
  );

  statusHeading.style.fontSize = "18px";
  statusHeading.style.fontWeight = "700";

  const statusDetails = createElement(
    "div",
    "Loading tracks"
  );

  statusDetails.style.marginTop = "5px";
  statusDetails.style.color =
    "var(--spice-subtext, #b3b3b3)";
  statusDetails.style.fontSize = "13px";

  const {
    wrapper: progressBar,
    fill: progressFill,
  } = createProgressBar();

  const progressNumbers = createElement(
    "div",
    "0 / 0"
  );

  progressNumbers.style.marginTop = "10px";
  progressNumbers.style.fontSize = "13px";
  progressNumbers.style.fontWeight = "700";
  progressNumbers.style.textAlign = "right";

  progressSection.append(
    statusHeading,
    statusDetails,
    progressBar,
    progressNumbers
  );

  const lensSection =
    createElement("div");

  lensSection.style.display = "none";
  lensSection.style.marginTop = "24px";
  lensSection.style.padding = "22px";
  lensSection.style.borderRadius = "12px";
  lensSection.style.background =
    "rgba(255, 255, 255, 0.06)";

  button.addEventListener(
    "click",
    async () => {
      button.disabled = true;
      button.style.cursor = "default";
      button.style.opacity = "0.75";
      button.textContent =
        "Loading Genre Lens";

      progressSection.style.display =
        "block";

      lensSection.style.display =
        "none";

      statusHeading.textContent =
        "Loading playlist";

      statusDetails.textContent =
        "Reading Spotify playlist tracks...";

      progressNumbers.textContent =
        "Preparing";

      try {
        const tracks =
          await getAllPlaylistTracks(
            playlist.id,
            (loaded, total) => {
              statusDetails.textContent =
                `${loaded.toLocaleString()} of ${total.toLocaleString()} tracks loaded`;
            }
          );

        const total = tracks.length;

        statusHeading.textContent =
          "Loading classifications";

        statusDetails.textContent =
          "Checking cached genres...";

        progressNumbers.textContent =
          `0 / ${total.toLocaleString()}`;

        const classifications =
          await classifyTracks(
            tracks,
            (
              completed,
              trackTotal,
              trackName
            ) => {
              const percentage =
                trackTotal > 0
                  ? Math.round(
                      (
                        completed /
                        trackTotal
                      ) * 100
                    )
                  : 0;

              progressFill.style.width =
                `${percentage}%`;

              statusHeading.textContent =
                `Loading Genre Lens: ${percentage}%`;

              statusDetails.textContent =
                `Current track: ${trackName}`;

              progressNumbers.textContent =
                `${completed.toLocaleString()} / ${trackTotal.toLocaleString()}`;
            }
          );

        progressFill.style.width =
          "100%";

        progressSection.style.display =
          "none";

        button.style.display = "none";

        lensSection.style.display =
          "block";

        renderGenreLens(
          lensSection,
          classifications
        );
      } catch (error) {
        statusHeading.textContent =
          "Genre Lens stopped";

        statusDetails.textContent =
          error instanceof Error
            ? error.message
            : String(error);

        button.disabled = false;
        button.style.cursor = "pointer";
        button.style.opacity = "1";
        button.textContent =
          "Resume Genre Lens";
      }
    }
  );

  container.append(
    button,
    progressSection,
    lensSection
  );

  return container;
}

export function openPlaylistModal(): void {
  const styleId =
    "playlist-plus-modal-size";

  let style = document.getElementById(
    styleId
  ) as HTMLStyleElement | null;

  if (!style) {
    style = document.createElement("style");
    style.id = styleId;

    style.textContent = `
      body:has(#playlist-plus-modal-root) [role="dialog"] {
        width: 90vw !important;
        max-width: 1200px !important;
        height: 88vh !important;
        max-height: 88vh !important;
      }

      body:has(#playlist-plus-modal-root) [role="dialog"] > div {
        max-width: none !important;
      }

      #playlist-plus-modal-root {
        box-sizing: border-box;
        width: 100%;
        min-width: 0;
        max-width: 100%;
        overflow-x: hidden;
      }

      #playlist-plus-modal-root * {
        box-sizing: border-box;
      }

      @media (max-width: 900px) {
        #playlist-plus-modal-root [style*="repeat(4"] {
          grid-template-columns:
            repeat(2, minmax(0, 1fr)) !important;
        }
      }
    `;

    document.head.append(style);
  }

  const content =
    createPlaylistModalContent();

  content.id =
    "playlist-plus-modal-root";

  Spicetify.PopupModal.display({
    title: "Playlist+",
    content,
    isLarge: true,
  });

  window.setTimeout(() => {
    const root =
      document.getElementById(
        "playlist-plus-modal-root"
      );

    const dialog = root?.closest(
      '[role="dialog"]'
    ) as HTMLElement | null;

    if (!dialog) {
      return;
    }

    dialog.style.setProperty(
      "width",
      "90vw",
      "important"
    );

    dialog.style.setProperty(
      "max-width",
      "1200px",
      "important"
    );

    dialog.style.setProperty(
      "height",
      "88vh",
      "important"
    );

    dialog.style.setProperty(
      "max-height",
      "88vh",
      "important"
    );

    dialog.style.setProperty(
      "overflow-x",
      "hidden",
      "important"
    );
  }, 50);
}






